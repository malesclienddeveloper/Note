   "source": [
    "# fankit-dl scan (Kaggle)\n",
    "Jalankan cell berurutan. Pastikan **Internet ON** di Settings notebook."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "!apt-get update -qq 2>/dev/null; apt-get install -y -qq nodejs npm 2>/dev/null; node --version\n",
    "!pip install -q playwright && playwright install chromium 2>&1 | tail -5"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os, glob\n",
    "os.chdir('/kaggle/working')\n",
    "chrome = glob.glob('/root/.cache/ms-playwright/chromium-*/chrome-linux/chrome')[0]\n",
    "print('CHROME:', chrome)\n",
    "os.environ['CHROME_PATH'] = chrome\n",
    "!rm -rf fankit-dl && mkdir -p fankit-dl\n",
    "!cp -r /kaggle/input/fankit-dl/* fankit-dl/ 2>/dev/null || true\n",
    "!ls fankit-dl"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "!cd fankit-dl && npm install --omit=dev 2>&1 | tail -5"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os, glob\n",
    "chrome = glob.glob('/root/.cache/ms-playwright/chromium-*/chrome-linux/chrome')[0]\n",
    "!cd fankit-dl && CHROME_PATH={chrome} node bin/fankit-dl.mjs --scan-only --out /kaggle/working/coc_assets --chrome {chrome} 2>&1 | tail -30".format(chrome=chrome)
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "!ls -la /kaggle/working/coc_assets && head -c 200 /kaggle/working/coc_assets/manifest.json"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "!cd /kaggle/working && zip -r manifest.zip coc_assets/manifest.json && ls -la manifest.zip"
   ]
  }
